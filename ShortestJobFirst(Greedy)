// Online C++ compiler to run C++ program online
#include <iostream>
#include <algorithm>
#include <climits>
using namespace std;

//striver
int sjf(int arr[], int n){
    sort(arr, arr + n);
    int t=0, wt=0;
    
    for (int i=0; i<n; i++){
        wt+=t;
        t+=arr[i];
    }
    
    return (wt/n);
}

